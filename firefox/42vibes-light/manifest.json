{
  "manifest_version": 2,
  "name": "42vibes Light",
  "version": "0.1.0",
  "description": "Light theme for Firefox built from the 42vibes palette: soft blue-grey surfaces, near-black text and deep teal accents.",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "theme": {
    "colors": {
      "frame": "#f7fafc",
      "frame_inactive": "#e6eef5",
      "tab_background_text": "#3f5262",
      "tab_text": "#08141f",
      "tab_selected": "#d5e2ee",
      "tab_line": "#177a69",
      "toolbar": "#e6eef5",
      "toolbar_text": "#08141f",
      "toolbar_field": "#e6eef5",
      "toolbar_field_text": "#08141f",
      "toolbar_field_border": "#a8bfd1",
      "toolbar_field_focus": "#d5e2ee",
      "toolbar_top_separator": "#e6eef5",
      "toolbar_bottom_separator": "#e6eef5",
      "popup": "#e6eef5",
      "popup_text": "#08141f",
      "popup_border": "#a8bfd1",
      "popup_highlight": "#d5e2ee",
      "popup_highlight_text": "#08141f",
      "sidebar": "#e6eef5",
      "sidebar_text": "#3f5262",
      "sidebar_border": "#a8bfd1",
      "button_background_hover": "#d5e2ee",
      "icons": "#3f5262",
      "ntp_background": "#f7fafc",
      "ntp_text": "#08141f"
    },
    "properties": {
      "color_scheme": "light"
    }
  }
}
